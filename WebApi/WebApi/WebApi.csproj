<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Force Production by default so a publish that forgets to set ASPNETCORE_ENVIRONMENT
         explicitly never ships as Development. Local dev still resolves to Development via
         launchSettings.json / the ASPNETCORE_ENVIRONMENT env var, both of which take
         precedence over this at run time. Note this only affects a web.config the SDK
         generates itself during publish - it has no effect on a web.config already committed
         to source control (see WebApi/WebApi/web.config), which must be kept correct by hand. -->
    <EnvironmentName>Production</EnvironmentName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Never ship developer settings in a publish output - these files only exist to override
         appsettings.json on a dev machine and must not land next to the deployed app. Use
         CopyToPublishDirectory (not Content Remove) so they're still copied to bin/ for local
         `dotnet build` / `dotnet run`, where ASPNETCORE_ENVIRONMENT=Development still needs them.
         appsettings.Development.local.json is gitignored and holds dev database credentials. -->
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
    <Content Update="appsettings.Development.local.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AspNetCoreRateLimit" Version="5.0.0" />
    <PackageReference Include="Google.Apis.Auth" Version="1.70.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.8" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.8" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.6" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.6" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.6" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Otp.NET" Version="1.4.0" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="9.0.1" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.12.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SimpleAuthNet\SimpleAuthNet.csproj" />
  </ItemGroup>

</Project>
